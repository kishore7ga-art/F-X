# Copy to .env for local development, or set these in Dokploy's dashboard
# (Application -> Environment) for deployment. NEVER commit a real .env.
#
# Every value below is a PLACEHOLDER. Replace all of them.

# =============================================================================
# DATABASE  (required)
# =============================================================================
# Managed cloud Postgres is the default. Paste your provider's connection
# string here, keeping `?sslmode=require` — TLS is negotiated automatically for
# any non-local host and verified against the system CA store.
#
#   Neon      postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/college_saas?sslmode=require
#   Supabase  postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require
#   Railway   postgresql://postgres:PASSWORD@HOST.proxy.rlwy.net:PORT/railway?sslmode=require
#
# Prefer the provider's POOLED / connection-pooler host when it offers one.
#
# NEVER use `localhost` for a deployed app — inside a container that resolves
# to the container itself, not your machine.
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/college_saas?sslmode=require

# Max concurrent connections this container opens. Keep it comfortably under
# your provider's limit (Neon free tier pooled: ~100; Supabase free: ~60).
DATABASE_POOL_MAX=10

# Only set to "true" if your provider uses a self-signed certificate. It turns
# off certificate verification, which removes protection against MITM.
# DATABASE_SSL_NO_VERIFY=false

# =============================================================================
# APPLICATION  (required)
# =============================================================================
# Signs the session cookie. Must be at least 32 characters or the app refuses
# to start. Generate one with:  openssl rand -base64 32
SESSION_SECRET=replace-with-a-random-string-of-at-least-32-characters

# =============================================================================
# SELF-HOSTED POSTGRES  (only for docker-compose.self-hosted-db.yml)
# =============================================================================
# Ignore these if you are using a cloud database. When the override file is
# used, DATABASE_URL above is replaced by one built from these values.
POSTGRES_USER=collegeadmin
POSTGRES_PASSWORD=replace-with-a-strong-random-password
POSTGRES_DB=college_saas

# =============================================================================
# LOCAL DEVELOPMENT
# =============================================================================
# For a Postgres running on your own machine, use this instead of the cloud URL
# above (no TLS is attempted for localhost):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/college_saas?schema=public
