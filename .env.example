# Copy to .env for local development, or set these in Dokploy's dashboard
# (Application -> Environment) for deployment. NEVER commit a real .env.
#
# Every value below is a PLACEHOLDER. Replace all of them.

# --- Postgres service (docker-compose `db`) ---
POSTGRES_USER=collegeadmin
POSTGRES_PASSWORD=replace-with-a-strong-random-password
POSTGRES_DB=college_saas

# --- Application ---
# Inside Docker Compose the host is the service name `db`.
# For local development against a local Postgres, use `localhost`.
DATABASE_URL=postgresql://collegeadmin:replace-with-a-strong-random-password@db:5432/college_saas?schema=public

# Signs the session cookie. Must be at least 32 characters.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=replace-with-a-random-string-of-at-least-32-characters
