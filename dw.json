{"pages":[{"slug":"/home","title":"Home","sections":[{"id":"def-home-navbar","title":"Navbar / Header [header] - Navbar / Header Variant","sectionType":"navbar","sortOrder":0,"code":"<style>\n    :root {\n      --text-color: #ffffff;\n      --nav-font: 'Arial', sans-serif;\n      --brand-font: 'Times New Roman', 'Georgia', serif;\n    }\n\n    * {\n      box-sizing: border-box;\n      margin: 0;\n      padding: 0;\n    }\n\n    body {\n      background-color: #5c6270; /* Fallback background matching the banner tone */\n      font-family: var(--nav-font);\n    }\n\n    /* Header Container */\n    .header {\n      width: 100%;\n      background: rgba(45, 52, 66, 0.75); /* Translucent dark overlay */\n      backdrop-filter: blur(8px);\n      display: flex;\n      justify-content: center;\n      align-items: center;\n      padding: 18px 30px;\n    }\n\n    .nav-container {\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      gap: 40px;\n      width: 100%;\n      max-width: 1300px;\n    }\n\n    /* Left & Right Nav Groups */\n    .nav-group {\n      display: flex;\n      list-style: none;\n      align-items: center;\n      gap: 36px;\n    }\n\n    .nav-link {\n      color: var(--text-color);\n      text-decoration: none;\n      font-size: 14px;\n      font-weight: 700;\n      letter-spacing: 1px;\n      text-transform: uppercase;\n      transition: opacity 0.2s ease;\n      white-space: nowrap;\n    }\n\n    .nav-link:hover {\n      opacity: 0.8;\n    }\n\n    /* Center Brand / Logo */\n    .brand-logo {\n      display: flex;\n      align-items: center;\n      gap: 14px;\n      text-decoration: none;\n      color: var(--text-color);\n      margin: 0 10px;\n    }\n\n    .crest-icon {\n      width: 48px;\n      height: 48px;\n      fill: #ffffff;\n      flex-shrink: 0;\n    }\n\n    .brand-text {\n      display: flex;\n      flex-direction: column;\n      line-height: 1.05;\n      text-align: left;\n    }\n\n    .brand-seoul {\n      font-family: var(--brand-font);\n      font-size: 20px;\n      font-weight: 400;\n      letter-spacing: 2px;\n      text-transform: uppercase;\n    }\n\n    .brand-sub {\n      font-family: var(--brand-font);\n      font-size: 10.5px;\n      letter-spacing: 1.2px;\n      text-transform: uppercase;\n      opacity: 0.9;\n    }\n  </style>\n\n\n\n  \n  \n  <title>Seoul National University Header</title>\n  \n\n\n\n  <header class=\"header\">\n    <div class=\"nav-container\">\n      \n      <ul class=\"nav-group left-nav\">\n        <li><a href=\"#\" class=\"nav-link\">Academics</a></li>\n        <li><a href=\"#\" class=\"nav-link\">Research</a></li>\n        <li><a href=\"#\" class=\"nav-link\">Admissions</a></li>\n      </ul>\n\n      \n      <a href=\"#\" class=\"brand-logo\" aria-label=\"Seoul National University Home\">\n        \n        <svg class=\"crest-icon\" viewbox=\"0 0 100 100\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n          \n          <path d=\"M22 68 C15 50 20 30 35 22 C30 32 32 45 40 52\"></path>\n          <path d=\"M78 68 C85 50 80 30 65 22 C70 32 68 45 60 52\"></path>\n          <path d=\"M25 75 C35 85 65 85 75 75\"></path>\n          \n          <line x1=\"28\" y1=\"28\" x2=\"72\" y2=\"72\" stroke-width=\"2.5\"></line>\n          <line x1=\"72\" y1=\"28\" x2=\"28\" y2=\"72\" stroke-width=\"2.5\"></line>\n          <path d=\"M68 22 C73 18 78 22 75 27 Z\" fill=\"currentColor\"></path>\n          <circle cx=\"28\" cy=\"28\" r=\"4\" fill=\"currentColor\"></circle>\n          \n          <rect x=\"36\" y=\"38\" width=\"28\" height=\"34\" rx=\"2\" fill=\"#2d3442\" stroke=\"currentColor\" stroke-width=\"2\"></rect>\n          \n          <path d=\"M42 38 L42 28 L50 34 L58 28 L58 38\" stroke-width=\"2\" fill=\"none\"></path>\n          \n          <line x1=\"41\" y1=\"46\" x2=\"59\" y2=\"46\" stroke-width=\"1.5\"></line>\n          <line x1=\"41\" y1=\"53\" x2=\"59\" y2=\"53\" stroke-width=\"1.5\"></line>\n          <line x1=\"41\" y1=\"60\" x2=\"59\" y2=\"60\" stroke-width=\"1.5\"></line>\n        </svg>\n\n        <div class=\"brand-text\">\n          <span class=\"brand-seoul\">Seoul</span>\n          <span class=\"brand-sub\">National</span>\n          <span class=\"brand-sub\">University</span>\n        </div>\n      </a>\n\n      \n      <ul class=\"nav-group right-nav\">\n        <li><a href=\"#\" class=\"nav-link\">SNU Now</a></li>\n        <li><a href=\"#\" class=\"nav-link\">Campus Life</a></li>\n        <li><a href=\"#\" class=\"nav-link\">About SNU</a></li>\n      </ul>\n    </div>\n  </header>\n\n\n"},{"id":"def-home-footer","title":"Footer","sectionType":"footer","sortOrder":1,"code":"<footer style=\"background:#090d16;color:#94a3b8;padding:40px 40px;font-family:system-ui, sans-serif;width:100%;box-sizing:border-box;border-top:1px solid #1e293b;text-align:center\">\n  <p style=\"font-size:13px;font-weight:700;color:#cbd5e1;margin:0\">© 2026 Greenfield University. All Rights Reserved.</p>\n  <p style=\"font-size:12px;color:#64748b;margin-top:8px\">Approved by AICTE, UGC &amp; Accredited by NAAC A++ Grade.</p>\n</footer>"}]},{"slug":"/about","title":"About Us","sections":[]},{"slug":"/academics","title":"Academics","sections":[]},{"slug":"/placements","title":"Placements","sections":[]},{"slug":"/contact","title":"Contact Us","sections":[]}]}