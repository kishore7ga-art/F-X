# Patterns are written WITHOUT a leading slash so they match at any depth —
# they cover the repo root and any /frontend or /backend subdirectory alike.

# ---- dependencies ----
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ---- build output ----
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# ---- environment / secrets ----
# Never commit real credentials. .env.example is the only env file tracked.
.env
.env.*
!.env.example

# ---- user uploads (runtime data, not source) ----
public/uploads/

# ---- testing ----
coverage/

# ---- logs ----
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---- local tooling / agent scaffolding (auto-installed, not project source) ----
.claude/
.agents/
.windsurf/
skills-lock.json

# ---- editor / OS ----
.DS_Store
Thumbs.db
*.pem
.idea/
.vscode/

# ---- deploy ----
.vercel
